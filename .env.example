# Copy to .env.local (apps/web) — never commit real values.
NEXT_PUBLIC_SITE_URL=https://crypsis.fun
NEXT_PUBLIC_X_URL=https://x.com/crypsisfun
APP_LIVE=false                             # false = "Launch soon" mode (NEXT_PUBLIC_APP_LIVE also accepted)
NEXT_PUBLIC_SOLANA_NETWORK=mainnet         # mainnet (owner: no devnet); devnet only for CI tests
NEXT_PUBLIC_HELIUS_RPC_URL=                # browser key, restricted to crypsis.fun; required on mainnet
NEXT_PUBLIC_HELIUS_API_KEY=                # optional: Ring indexer/prover key; defaults to the api-key in the RPC URL
NEXT_PUBLIC_HELIUS_WS_URL=
NEXT_PUBLIC_SPR_INDEXER_URL=
NEXT_PUBLIC_SPR_PROVER_URL=
HELIUS_API_KEY=                            # server only
HELIUS_WEBHOOK_SECRET=
DATABASE_URL=
CRON_SECRET=
SITE_ACCESS_KEY=                           # private preview: key to enter the site (16+ chars); on Vercel the site is closed without it
SITE_PUBLIC=false                          # true = open the site to everyone
PINATA_JWT=                                # optional, IPFS fallback

# --- optional (added during implementation) ---
IPFS_GATEWAY=                              # default https://ipfs.io/ipfs/ (the only img-src host in the CSP)
PUMP_IPFS_ENABLED=                         # true = try pump.fun/api/ipfs first (dead as of 2026-11-24)
NEXT_PUBLIC_ENABLE_DEV_PAGES=              # true = keep /dev/* pages on mainnet builds
MAINNET_RPC_URL=                           # scripts only (backfill / simulations); defaults to Helius when HELIUS_API_KEY is set
RPC_MIN_INTERVAL_MS=                       # scripts only: throttle for public RPCs
