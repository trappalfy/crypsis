{
  "name": "crypsis",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @crypsis/db migrate",
    "e2e": "pnpm --filter web e2e",
    "tracker:backfill": "pnpm --filter web tracker:backfill",
    "launch:simulate": "pnpm --filter web exec tsx scripts/launch-simulate.ts"
  }
}
